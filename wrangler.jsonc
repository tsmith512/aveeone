{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aveeone",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],

  // Serve from a custom domain (Cloudflare creates/manages the DNS + cert).
  // The zone tsmith.net must be on this Cloudflare account.
  "routes": [
    {
      "pattern": "aveeone.tsmith.net",
      "custom_domain": true
    }
  ],

  // Observability on with 100% sampling, including distributed traces.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },

  // The ffmpeg container, built from ./Dockerfile. AV1 encoding is CPU-heavy,
  // so we use a "standard" instance class (standard-4 = most vCPU available).
  "containers": [
    {
      "class_name": "Transcoder",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 10
    }
  ],

  // Cache of transcoded outputs. Keys: OUTPUT_PREFIX/av1-unedited/<sha256(url)>.
  "r2_buckets": [
    {
      "binding": "OUTPUTS",
      "bucket_name": "aveeone-prod"
    }
  ],

  // Containers are backed by Durable Objects.
  "durable_objects": {
    "bindings": [
      {
        "name": "TRANSCODER",
        "class_name": "Transcoder"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Transcoder"]
    }
  ]
}
